<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CanfarDesktop.Views.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:dialogs="using:CanfarDesktop.Views.Dialogs"
    xmlns:notebook="using:CanfarDesktop.Views.Notebook"
    x:Uid="SettingsDialog"
    Title="Settings"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <!-- Sized from the inside out, because nothing here scrolls sideways and whatever does not fit is
             cut off. The panes hold 440-wide panels: 440 + 2×20 padding + a scrollbar's gutter needs a
             500-wide content area. The list needs 220 for its longest name, "Découverte d'images" with its
             icon. 720 in all — and the dialog's cap has to clear that plus its own 2×24 margin. At 640/168
             the names were cut ("Image discover", "AI compu") and every pane lost its right edge. -->
        <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
    </ContentDialog.Resources>

    <!-- The Grid only carries AgentPointerHost: an agent's hints about controls in here live in the dialog,
         above it and closing with it, rather than in the window behind its smoke layer. -->
    <Grid>
    <muxc:NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="220"
                         IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                         IsPaneToggleButtonVisible="False"
                         SelectionChanged="OnNavSelectionChanged"
                         Width="720" Height="460">
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem x:Uid="Settings_NavGeneral" Content="General" Tag="general">
                <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Uid="Settings_NavPortal" Content="Portal" Tag="portal">
                <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Uid="Settings_NavAgent" Content="AI agent" Tag="agent">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Uid="Settings_NavDiscovery" Content="Image discovery" Tag="discovery">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Uid="Settings_NavCompute" Content="AI compute" Tag="compute">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE753;" /></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Uid="Settings_NavNotebook" Content="Notebook" Tag="notebook">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem x:Uid="Settings_NavAbout" Content="About" Tag="about">
                <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12,20,12">
            <Grid>
                <!-- General -->
                <StackPanel x:Name="GeneralPanel" Spacing="14">
                    <TextBlock x:Uid="Settings_GeneralHeader" Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="ThemeCombo" x:Uid="Settings_ThemeCombo" Header="Theme" Width="220" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem x:Uid="Settings_ThemeSystem" Content="System" Tag="System" />
                        <ComboBoxItem x:Uid="Settings_ThemeLight" Content="Light" Tag="Light" />
                        <ComboBoxItem x:Uid="Settings_ThemeDark" Content="Dark" Tag="Dark" />
                    </ComboBox>

                    <!-- Language / Langue: applied at next launch via ApplicationLanguages.PrimaryLanguageOverride
                         (macOS behaves the same way — the override is read at startup). -->
                    <ComboBox x:Name="LanguageCombo" x:Uid="Settings_LanguageCombo" Header="Language" Width="220" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem x:Uid="Settings_LanguageSystem" Content="System default" Tag="system" />
                        <ComboBoxItem x:Uid="Settings_LanguageEnglish" Content="English" Tag="en" />
                        <ComboBoxItem x:Uid="Settings_LanguageFrench" Content="Français" Tag="fr" />
                    </ComboBox>
                    <TextBlock x:Uid="Settings_LanguageCaption" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Verbinal needs to restart to apply the new language." />
                    <!-- Appears when the user actually changes the language: offers the restart instead
                         of leaving them to figure out how to apply it. -->
                    <muxc:InfoBar x:Name="LanguageRestartBar" IsOpen="False" Severity="Informational"
                                  IsClosable="True" MaxWidth="440" HorizontalAlignment="Left"
                                  x:Uid="Settings_LanguageRestartBar"
                                  Message="The new language takes effect after a restart.">
                        <muxc:InfoBar.ActionButton>
                            <Button x:Uid="Settings_RestartNowButton" Content="Restart now" Click="OnRestartNowClick" />
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <TextBlock x:Uid="Settings_AdvancedHeader" Text="Advanced" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Expander x:Uid="Settings_EndpointsExpander" Header="Service endpoints" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Settings_EndpointsCaption" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Every CANFAR/CADC service host the app talks to. The defaults are the standard public hosts — change them only to target a mirror or staging deployment. New requests use the updated hosts immediately; invalid values fall back to the default." />
                            <TextBox x:Name="EpLoginBox" x:Uid="Settings_EpLoginBox" Header="CADC login (ac)" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws-cadc.canfar.net/ac" LostFocus="OnGeneralChanged" />
                            <TextBox x:Name="EpSkahaBox" x:Uid="Settings_EpSkahaBox" Header="Skaha sessions" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws-uv.canfar.net/skaha" LostFocus="OnGeneralChanged" />
                            <TextBox x:Name="EpAcBox" x:Uid="Settings_EpAcBox" Header="User info (ac)" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws-uv.canfar.net/ac" LostFocus="OnGeneralChanged" />
                            <TextBox x:Name="EpArcNodesBox" x:Uid="Settings_EpArcNodesBox" Header="ARC nodes (VOSpace listing)" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws-uv.canfar.net/arc/nodes" LostFocus="OnGeneralChanged" />
                            <TextBox x:Name="EpArcFilesBox" x:Uid="Settings_EpArcFilesBox" Header="ARC files (VOSpace transfer)" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws-uv.canfar.net/arc/files" LostFocus="OnGeneralChanged" />
                            <TextBox x:Name="EpTapBox" x:Uid="Settings_EpTapBox" Header="TAP (archive search)" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws.cadc-ccda.hia-iha.nrc-cnrc.gc.ca/argus" LostFocus="OnGeneralChanged" />
                            <TextBox x:Name="EpCaom2OpsBox" x:Uid="Settings_EpCaom2OpsBox" Header="CAOM2 ops (metadata + downloads)" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws.cadc-ccda.hia-iha.nrc-cnrc.gc.ca/caom2ops" LostFocus="OnGeneralChanged" />
                            <TextBox x:Name="EpResolverBox" x:Uid="Settings_EpResolverBox" Header="Target resolver" Width="420" HorizontalAlignment="Left"
                                     PlaceholderText="https://ws.cadc-ccda.hia-iha.nrc-cnrc.gc.ca/cadc-target-resolver" LostFocus="OnGeneralChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="Settings_EndpointsResetButton" Content="Reset to defaults" Click="OnResetEndpointsClick" />
                                <Button x:Name="TestConnectionsButton" x:Uid="Settings_TestConnectionsButton"
                                        Content="Test connections" Click="OnTestConnectionsClick" />
                            </StackPanel>
                            <ItemsControl x:Name="ProbeResultsList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Uid="Settings_AutoSaveCaption" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Changes are saved automatically." />
                </StackPanel>

                <!-- Portal (session-launch defaults; macOS Portal settings tab parity) -->
                <StackPanel x:Name="PortalPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Uid="Settings_PortalHeader" Text="Portal" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBlock x:Uid="Settings_DefaultsHeader" Text="Defaults" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="SessionTypeCombo" x:Uid="Settings_SessionTypeCombo" Header="Default session type" Width="220" SelectionChanged="OnPortalChanged">
                        <ComboBoxItem Content="notebook" Tag="notebook" />
                        <ComboBoxItem Content="desktop" Tag="desktop" />
                        <ComboBoxItem Content="carta" Tag="carta" />
                        <ComboBoxItem Content="contributed" Tag="contributed" />
                        <ComboBoxItem Content="firefly" Tag="firefly" />
                    </ComboBox>
                    <TextBlock x:Uid="Settings_SessionTypeCaption" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Applied whenever you open the Portal launch form." />

                    <TextBlock x:Uid="Settings_ResourceDefaultsHeader" Text="Resource defaults" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="ResourcePresetCombo" x:Uid="Settings_ResourcePresetCombo" Header="Preset" Width="220" SelectionChanged="OnResourcePresetChanged">
                        <ComboBoxItem x:Uid="Settings_PresetNone" Content="None" Tag="none" />
                        <ComboBoxItem x:Uid="Settings_PresetFlexible" Content="Flexible" Tag="flexible" />
                        <ComboBoxItem x:Uid="Settings_PresetFixed" Content="Fixed" Tag="fixed" />
                    </ComboBox>
                    <StackPanel x:Name="FixedResourcePanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <muxc:NumberBox x:Name="CoresBox" x:Uid="Settings_CoresBox" Header="Cores" Minimum="1" Maximum="64"
                                        SpinButtonPlacementMode="Inline" Width="130" ValueChanged="OnPortalNumberChanged" />
                        <muxc:NumberBox x:Name="RamBox" x:Uid="Settings_RamBox" Header="RAM (GB)" Minimum="1" Maximum="256"
                                        SpinButtonPlacementMode="Inline" Width="130" ValueChanged="OnPortalNumberChanged" />
                        <muxc:NumberBox x:Name="GpusBox" x:Uid="Settings_GpusBox" Header="GPUs" Minimum="0" Maximum="16"
                                        SpinButtonPlacementMode="Inline" Width="130" ValueChanged="OnPortalNumberChanged" />
                    </StackPanel>
                    <TextBlock x:Uid="Settings_ResourceCaption" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Optional. When a preset is set, the launch form starts with these resource settings." />

                    <Button x:Uid="Settings_ClearDefaultsButton" Content="Clear all defaults" Click="OnClearPortalDefaults" HorizontalAlignment="Left" />
                    <TextBlock x:Uid="Settings_AutoSaveCaption" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Changes are saved automatically." />
                </StackPanel>

                <!-- AI agent (embedded MCP panel + the guided wizard) -->
                <StackPanel x:Name="AgentPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Uid="Settings_AgentHeader" Text="AI agent" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button x:Uid="Settings_ConnectWizardButton" Content="Connect an AI agent (guided)…" Click="OnOpenWizard" Style="{StaticResource AccentButtonStyle}" />
                    <ToggleSwitch x:Name="AgentSoundsToggle" x:Uid="Settings_AgentSoundsToggle"
                                  Header="Sound when an agent starts and finishes"
                                  Toggled="OnAgentSoundsToggled" />
                    <TextBlock x:Uid="Settings_AgentSoundsHint" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Left"
                               Text="Two short cues, so you notice an agent working while you are looking at something else." />
                    <dialogs:McpServerSettingsPanel />
                </StackPanel>

                <!-- Image discovery (embedded) -->
                <StackPanel x:Name="DiscoveryPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Uid="Settings_DiscoveryHeader" Text="Image discovery" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <dialogs:ImageDiscoverySettingsPanel x:Name="DiscoverySettingsPanel" Width="440" />
                </StackPanel>

                <!-- AI compute (embedded) -->
                <StackPanel x:Name="ComputePanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Uid="Settings_ComputeHeader" Text="AI compute" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <dialogs:AIComputeSettingsPanel x:Name="ComputeSettingsPanel" Width="440" />
                </StackPanel>

                <!-- Notebook (embedded) -->
                <StackPanel x:Name="NotebookPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Uid="Settings_NotebookHeader" Text="Notebook" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <notebook:NotebookSettingsPanel />
                </StackPanel>

                <!-- About: the app's one About surface (the old toolbar dialog was removed).
                     Everything centered on one axis for a deliberate, aligned composition. -->
                <StackPanel x:Name="AboutPanel" Spacing="6" Visibility="Collapsed" HorizontalAlignment="Center"
                            Margin="0,32,0,16">
                    <Image Source="ms-appx:///Assets/Verbinal_icon.png" Width="72" Height="72"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Verbinal" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AboutSubtitleText" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="© 2026 Serhii Zautkin" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Uid="Settings_AboutBody" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="A native Windows client for the Canadian Astronomy Data Centre and CANFAR Science Platform — search, view, compute, and storage." />
                    <!-- verbinal.com is the APP; canfar.net is the observatory it talks to. Somebody
                         asking "what is this program?" is offered the first, and the second is named for
                         what it is rather than being the only link on the page. -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <HyperlinkButton x:Name="WebsiteLink" x:Uid="Settings_AboutVisitLink" Content="verbinal.com" />
                        <HyperlinkButton x:Name="IssuesLink" x:Uid="Settings_AboutIssuesLink" Content="Report an issue" />
                        <HyperlinkButton x:Name="TermsLink" x:Uid="Settings_AboutTermsLink" Content="Terms of Use" Click="OnTermsLinkClick" />
                    </StackPanel>
                    <HyperlinkButton x:Uid="Settings_AboutCanfarLink" Content="About CANFAR, the service"
                                     NavigateUri="https://www.canfar.net" HorizontalAlignment="Center" />

                    <!-- The versions a bug report needs, read at run time. Collapsed by default because
                         it is for the moment somebody is filing one, not for the moment they are
                         reading who wrote the app. -->
                    <Expander x:Uid="Settings_RuntimeExpander" Header="Runtime info" HorizontalAlignment="Stretch"
                              Margin="0,16,0,0" MaxWidth="400">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="RuntimeText" FontFamily="Consolas" FontSize="12"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <Button x:Name="CopyRuntimeButton" x:Uid="Settings_CopyRuntimeButton"
                                    Content="Copy" Click="OnCopyRuntimeInfo" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </muxc:NavigationView>
    <Grid x:Name="AgentPointerHost" />
    </Grid>
</ContentDialog>
