<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CanfarDesktop.Views.Dialogs.RegistryBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:CanfarDesktop.Views.Dialogs"
    x:Uid="Images_RegistryDialog"
    Title="Find an image in the registry"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid Width="720" Height="520" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="The platform's catalogue lists the images it will launch. This searches the registry behind it — a colleague's build, or a tag the catalogue has not picked up. Nothing is searched until you ask." />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="QueryBox" PlaceholderText="Repository name, or part of one"
                     KeyDown="OnQueryKeyDown" AutomationProperties.Name="Search the registry" />
            <Button Grid.Column="1" x:Name="SearchButton" Content="Search" Click="OnSearchClick"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <InfoBar Grid.Row="2" x:Name="ResultBar" IsOpen="False" IsClosable="False" />

        <ListView Grid.Row="3" x:Name="ResultList" SelectionMode="None"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:RegistryResultRow">
                    <Grid ColumnSpacing="10" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{x:Bind ImageId}" FontFamily="Consolas" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind TypesLine}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind StateText}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="2" Content="Add" Click="OnAddClick" IsEnabled="{x:Bind CanAdd}"
                                AutomationProperties.Name="Add this image to my list" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
