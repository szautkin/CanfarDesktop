<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CanfarDesktop.Views.Dialogs.ImageDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:CanfarDesktop.Views.Dialogs"
    x:Uid="Images_DetailDialog"
    Title="Inside this image"
    CloseButtonText="Close"
    PrimaryButtonText="Use this image"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid Width="720" Height="560" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="ImageIdText" Style="{StaticResource BodyStrongTextBlockStyle}"
                       FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="OsText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="CapabilitiesText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar Grid.Row="1" x:Name="NotesBar" IsOpen="False" IsClosable="False" Severity="Informational" />

        <!-- The median image here holds 624 packages. Without a filter this list is something to
             scroll past rather than something to read. -->
        <AutoSuggestBox Grid.Row="2" x:Name="FilterBox" x:Uid="Images_PackageFilter" QueryIcon="Find"
                        PlaceholderText="Filter packages"
                        TextChanged="OnFilterChanged"
                        AutomationProperties.Name="Filter packages" />

        <!-- One virtualized list, flattened across ecosystems: a hundred rows of ListView inside an
             ItemsControl is what made the macOS build stutter on a big image. -->
        <ListView Grid.Row="3" x:Name="PackageList" SelectionMode="None"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:PackageRow">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontFamily="Consolas" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="{x:Bind HeaderWeight}"
                                   Foreground="{x:Bind Foreground}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Version}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
