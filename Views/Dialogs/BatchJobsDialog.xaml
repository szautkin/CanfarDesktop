<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CanfarDesktop.Views.Dialogs.BatchJobsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="Batch_Dialog"
    Title="Batch Jobs"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <DataTemplate x:Key="JobRowTemplate">
            <Grid Padding="4,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Id}" Opacity="0.6"
                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SessionName}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ImageLabel}" Opacity="0.7"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Tag="{Binding Id}" x:Uid="Batch_EventsBtn" Click="OnEventsClick"
                            ToolTipService.ToolTip="Events" Padding="6,4"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE81C;" FontSize="12" />
                    </Button>
                    <Button Tag="{Binding Id}" x:Uid="Batch_LogsBtn" Click="OnLogsClick"
                            ToolTipService.ToolTip="Logs" Padding="6,4"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE756;" FontSize="12" />
                    </Button>
                    <Button Tag="{Binding Id}" x:Uid="Batch_DeleteBtn" Click="OnDeleteClick"
                            ToolTipService.ToolTip="Delete" Padding="6,4"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FFF44336" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--
            History rows carry no Events / Logs / Delete buttons on purpose: the job is GONE. Skaha has
            reaped it, and the probe jobs the app runs itself are deleted the moment they finish, so
            those three buttons would all be dead. The reason captured while the job still existed is
            what the row has instead, and it is the whole point of remembering.
        -->
        <DataTemplate x:Key="HistoryRowTemplate">
            <Grid Padding="4,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <FontIcon Grid.Row="0" Grid.Column="0" Glyph="{Binding Glyph}" FontSize="12"
                          Foreground="{Binding Colour}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding When}" Opacity="0.6"
                           FontSize="12" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                           Opacity="0.75" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid x:Name="ContentRoot">
        <Pivot x:Name="TabPivot" IsHeaderItemsCarouselEnabled="False">
            <PivotItem x:Name="PendingTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#FFFF9800" VerticalAlignment="Center" />
                        <TextBlock x:Name="PendingHeader" />
                    </StackPanel>
                </PivotItem.Header>
                <ListView x:Name="PendingList" SelectionMode="None"
                          ItemTemplate="{StaticResource JobRowTemplate}" />
            </PivotItem>

            <PivotItem x:Name="RunningTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#FF4CAF50" VerticalAlignment="Center" />
                        <TextBlock x:Name="RunningHeader" />
                    </StackPanel>
                </PivotItem.Header>
                <ListView x:Name="RunningList" SelectionMode="None"
                          ItemTemplate="{StaticResource JobRowTemplate}" />
            </PivotItem>

            <PivotItem x:Name="CompletedTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#FF2196F3" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompletedHeader" />
                    </StackPanel>
                </PivotItem.Header>
                <ListView x:Name="CompletedList" SelectionMode="None"
                          ItemTemplate="{StaticResource JobRowTemplate}" />
            </PivotItem>

            <PivotItem x:Name="HistoryTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81C;" FontSize="12" />
                        <TextBlock x:Name="HistoryHeader" />
                    </StackPanel>
                </PivotItem.Header>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0" x:Name="HistoryList" SelectionMode="None"
                              ItemTemplate="{StaticResource HistoryRowTemplate}" />
                    <TextBlock Grid.Row="0" x:Name="HistoryEmptyText" x:Uid="Batch_HistoryEmpty"
                               Visibility="Collapsed" Opacity="0.7" TextWrapping="Wrap" MaxWidth="420"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="No finished jobs remembered yet. CANFAR clears jobs once they end, so what happens from now on is kept here." />
                    <HyperlinkButton Grid.Row="1" x:Name="ClearHistoryButton" x:Uid="Batch_ClearHistory"
                                     Content="Clear history" Click="OnClearHistory"
                                     HorizontalAlignment="Left" Visibility="Collapsed" />
                </Grid>
            </PivotItem>

            <PivotItem x:Name="FailedTab">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#FFF44336" VerticalAlignment="Center" />
                        <TextBlock x:Name="FailedHeader" />
                    </StackPanel>
                </PivotItem.Header>
                <ListView x:Name="FailedList" SelectionMode="None"
                          ItemTemplate="{StaticResource JobRowTemplate}" />
            </PivotItem>
        </Pivot>
    </Grid>
</ContentDialog>
