<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CanfarDesktop.Views.RemoteComputePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The person's view of run_code: the session it runs in, what has run, and a box to run code
         themselves. Before this, an assistant could start a session and run code on somebody's account
         with nothing in the app to show it had. -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Title, what this is, and where it stands ── -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Compute_PageTitle" Text="Remote Compute" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="Compute_PageIntro" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Code your AI assistant runs with run_code, and code you run here, goes to one session on your CANFAR account named verbinal-compute. It uses your cores, has no shell and no inbound network, and writes its results back to your storage." />
            </StackPanel>
            <Border Grid.Column="1" x:Name="StatusChip" VerticalAlignment="Top" CornerRadius="12" Padding="12,4"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>
        </Grid>

        <!-- ── Toolbar ── -->
        <StackPanel Grid.Row="1" x:Name="Toolbar" Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton" x:Uid="Compute_StartButton" Content="Start" Click="OnStartClick"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="StopButton" x:Uid="Compute_StopButton" Content="Stop" Click="OnStopClick" />
            <Button x:Name="RefreshButton" x:Uid="Compute_RefreshButton" Click="OnRefreshClick"
                    ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button x:Name="SettingsButton" x:Uid="Compute_SettingsButton" Content="Settings" Click="OnSettingsClick" />
            <Button x:Name="OpenFolderButton" x:Uid="Compute_OpenFolderButton" Content="Open folder in Storage"
                    Click="OnOpenFolderClick" />
            <HyperlinkButton x:Name="RepoLink" x:Uid="Compute_RepoLink" Content="verbinal-execution on GitHub" />
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="MessageBar" IsClosable="True" IsOpen="False" />

        <!-- ── Not set up: what it takes ── -->
        <ScrollViewer Grid.Row="3" x:Name="SetupPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border CornerRadius="8" Padding="20" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Compute_SetupTitle" Text="Set up remote compute" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Compute_SetupStep1" TextWrapping="Wrap"
                               Text="1. Get the watcher image. Build verbinal-execution from its repository and push it to your project on images.canfar.net." />
                    <TextBlock x:Uid="Compute_SetupStep2" TextWrapping="Wrap"
                               Text="2. Open Settings ▸ AI compute and set the image, the cores and RAM it runs with, and a registry login if the image is private." />
                    <TextBlock x:Uid="Compute_SetupStep3" TextWrapping="Wrap"
                               Text="3. Come back here and press Start. The session takes a minute or two to come up." />
                    <TextBlock x:Uid="Compute_SetupNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="With auto-apply on, your assistant's code runs without asking first. Turn auto-apply off in Settings to approve each run." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SetupSettingsButton" x:Uid="Compute_SetupSettingsButton" Content="Open Settings"
                                Click="OnSettingsClick" Style="{StaticResource AccentButtonStyle}" />
                        <HyperlinkButton x:Name="SetupRepoLink" x:Uid="Compute_SetupRepoLink" Content="Open the repository" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ── Set up: the runs, and running code ── -->
        <Grid Grid.Row="3" x:Name="MainPanel" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RunsCaption" x:Uid="Compute_HistoryTitle" Text="RUNS" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" />
                <ListView Grid.Row="1" x:Name="RunList" SelectionMode="Single" SelectionChanged="OnRunSelected"
                          AutomationProperties.LabeledBy="{x:Bind RunsCaption}" />
                <TextBlock Grid.Row="1" x:Name="EmptyHistory" x:Uid="Compute_EmptyHistory" Text="Nothing has run yet."
                           Style="{StaticResource CaptionTextBlockStyle}" Margin="4,4,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>

            <Pivot Grid.Column="1" x:Name="ComputePivot">
                <PivotItem x:Name="DetailTab" x:Uid="Compute_DetailTab" Header="Selected run">
                    <Grid RowSpacing="8" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RunMeta" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="1" x:Name="CopyCodeButton" x:Uid="Compute_CopyCodeButton" Content="Copy code"
                                    Click="OnCopyCodeClick" IsEnabled="False" />
                            <Button Grid.Column="2" x:Name="RunAgainButton" x:Uid="Compute_RunAgainButton" Content="Run again"
                                    Click="OnRunAgainClick" IsEnabled="False" />
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="CodeView" x:Uid="Compute_CodeView" Header="Code" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <TextBlock Grid.Row="2" x:Name="OutputCaption" x:Uid="Compute_OutputLabel" Text="Output" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox Grid.Row="3" x:Name="OutputView" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" AutomationProperties.LabeledBy="{x:Bind OutputCaption}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <TextBlock Grid.Row="4" x:Name="ErrorCaption" x:Uid="Compute_ErrorLabel" Text="Errors" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox Grid.Row="5" x:Name="ErrorView" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" AutomationProperties.LabeledBy="{x:Bind ErrorCaption}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </PivotItem>

                <PivotItem x:Name="RunTab" x:Uid="Compute_RunTab" Header="Run code">
                    <Grid RowSpacing="8" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="LanguageCombo" x:Uid="Compute_LanguageCombo" Header="Language" MinWidth="140" SelectedIndex="0">
                                <ComboBoxItem Content="Python" Tag="python" />
                                <ComboBoxItem Content="Bash" Tag="bash" />
                            </ComboBox>
                            <NumberBox x:Name="TimeoutBox" x:Uid="Compute_TimeoutBox" Header="Timeout (seconds)" Value="60"
                                       Minimum="1" Maximum="900" SpinButtonPlacementMode="Compact" MinWidth="160" />
                        </StackPanel>
                        <!-- What can run, said where the choice is made: the watcher takes Python and Bash,
                             and Bash is the way to anything else the image has installed. -->
                        <TextBlock x:Name="LanguageNote" x:Uid="Compute_LanguageNote" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.Name="Python or Bash"
                                   Text="Python or Bash. From Bash you can run anything installed in the compute image, such as Rscript or julia if it has them." />
                        </StackPanel>
                        <TextBox Grid.Row="1" x:Name="SnippetBox" x:Uid="Compute_SnippetBox" Header="Code"
                                 PlaceholderText="print('hello from CANFAR')"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Button Grid.Row="2" x:Name="RunButton" x:Uid="Compute_RunButton" Content="Run" Click="OnRunClick"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</UserControl>
