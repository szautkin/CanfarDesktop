<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CanfarDesktop.Views.FitsViewer.FitsViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CanfarDesktop.Views.Controls">

    <Grid RowDefinitions="*,Auto">

        <!-- Main content: header panel + image canvas -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Header panel (collapsible) -->
            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                    <!-- Marks, at the top of the control column and collapsed until wanted. Everything
                         about them lives here — the pencil, the shape, the style and the list — rather
                         than the pencil being in the toolbar and the list nowhere. -->
                    <Expander Grid.Row="0" x:Name="MarksExpander" x:Uid="Fits_MarksExpander"
                              Header="Marks" HorizontalAlignment="Stretch" Margin="4,4,4,0"
                              HorizontalContentAlignment="Stretch"
                              Expanding="OnMarksExpanding" Collapsed="OnMarksCollapsed">
                        <controls:MarksPanel x:Name="MarksPanelControl" MaxHeight="420" />
                    </Expander>

                    <!-- HDU selector (multi-extension files only): pick which HDU/extension to view -->
                    <StackPanel x:Name="HduSection" Grid.Row="1" Spacing="2" Margin="6,6,6,2" Visibility="Collapsed">
                        <TextBlock x:Uid="Fits_HduHeader" Text="Extensions (HDUs)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12" />
                        <ListView x:Name="HduList" SelectionMode="Single" MaxHeight="140"
                                  SelectionChanged="OnHduSelectionChanged" Padding="0,2">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="6,3" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontFamily="Consolas"
                                               Opacity="{Binding DimOpacity}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,2" />
                    </StackPanel>

                    <!-- Synthesized image summary (WCS, scale, field, instrument…) above the raw header -->
                    <StackPanel Grid.Row="2" Spacing="2" Margin="6,6,6,2">
                        <TextBlock x:Uid="Fits_ImageInfoHeader" Text="Image info"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12" />
                        <ItemsControl x:Name="ImageInfoList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="104,*" Padding="0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                                   FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="3" x:Name="HeaderFilter" x:Uid="Fits_HeaderFilter"
                             PlaceholderText="Search headers..."
                             Margin="4" TextChanged="OnHeaderFilterChanged" />
                    <ListView Grid.Row="4" x:Name="HeaderList" SelectionMode="None"
                              Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,*,*" Padding="2">
                                    <TextBlock Grid.Column="0" Text="{Binding Keyword}"
                                               FontFamily="Consolas" FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               FontFamily="Consolas" FontSize="11"
                                               Margin="8,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Comment}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Image canvas: manual zoom/pan via CompositeTransform -->
            <Grid Grid.Column="1" Background="Black" x:Name="ImageCanvas" x:Uid="Fits_ImageCanvas"
                  IsTabStop="True" UseSystemFocusVisuals="True"
                  AutomationProperties.Name="Image canvas"
                  PointerPressed="OnCanvasPointerPressed"
                  PointerMoved="OnCanvasPointerMoved"
                  PointerReleased="OnCanvasPointerReleased"
                  PointerCanceled="OnCanvasPointerReleased"
                  PointerWheelChanged="OnCanvasWheelChanged"
                  ContextRequested="OnCanvasContextRequested"
                  DoubleTapped="OnCanvasDoubleTapped">
                <Image x:Name="FitsImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="ImageTransform" />
                    </Image.RenderTransform>
                </Image>

                <!-- Naming a mark, over the mark itself. An ordinary control rather than a flyout: a
                     flyout dismisses when the pointer returns to the image, commits on close so Escape
                     saves, and has nowhere to put a bin. -->
                <controls:MarkLabelEditor x:Name="MarkEditorField" Visibility="Collapsed" />

                <!-- Blink overlay (fades on top of main image, never changes transforms) -->
                <Image x:Name="BlinkImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5"
                       Opacity="0"
                       IsHitTestVisible="False"
                       Visibility="Collapsed">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="BlinkTransform" />
                    </Image.RenderTransform>
                </Image>

                <!-- Marks. Under the crosshair, which is chrome and has to stay readable over them;
                     never hit-testable, because the canvas beneath decides what a press means. -->
                <controls:AnnotationLayer x:Name="AnnotationCanvas" IsHitTestVisible="False" />

                <!-- Off-screen host: the export plate is parented here, laid out, and rasterized, then
                     removed. Its children sit far off-screen so they never appear over the viewer. -->
                <Canvas x:Name="ExportHost" IsHitTestVisible="False" />

                <!-- What is happening while a file is read.
                     A mosaic has forty-one extensions and takes tens of seconds; the only thing on
                     screen for that was a twenty-pixel spinner in the toolbar, which says something
                     is happening and not whether it is nearly done or stuck. -->
                <Border x:Name="LoadingPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="20,16" CornerRadius="8" MinWidth="280"
                        Background="#D0101622" BorderBrush="#40FFFFFF" BorderThickness="1"
                        IsHitTestVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="LoadingTitle" FontWeight="SemiBold"
                                   Foreground="#FFF0F0F0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="LoadingBar" Minimum="0" Maximum="1" Width="240" />
                        <TextBlock x:Name="LoadingDetail" FontSize="12" Opacity="0.75"
                                   Foreground="#FFE0E0E0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- The region being dragged out for a figure. -->
                <Canvas x:Name="RegionCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="RegionRect" Visibility="Collapsed"
                               Stroke="{ThemeResource SystemFillColorAttentionBrush}"
                               StrokeThickness="1.5" StrokeDashArray="5,3"
                               Fill="#20FFFFFF" />
                </Canvas>

                <!-- Crosshair overlay (click to place) -->
                <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False">
                    <!-- Linked crosshair (from other tabs, dashed) -->
                    <Line x:Name="LinkedCrosshairH"
                          Stroke="{ThemeResource SystemFillColorCautionBrush}"
                          StrokeDashArray="4,4"
                          StrokeThickness="1" Visibility="Collapsed" />
                    <Line x:Name="LinkedCrosshairV"
                          Stroke="{ThemeResource SystemFillColorCautionBrush}"
                          StrokeDashArray="4,4"
                          StrokeThickness="1" Visibility="Collapsed" />
                    <!-- Primary crosshair (user-placed) -->
                    <Line x:Name="CrosshairH"
                          Stroke="{ThemeResource SystemFillColorAttentionBrush}"
                          StrokeThickness="1" Visibility="Collapsed" />
                    <Line x:Name="CrosshairV"
                          Stroke="{ThemeResource SystemFillColorAttentionBrush}"
                          StrokeThickness="1" Visibility="Collapsed" />
                    <Border x:Name="CrosshairLabel" Visibility="Collapsed"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="CrosshairText"
                                   Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                   FontFamily="Consolas" FontSize="11" />
                    </Border>
                </Canvas>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="1" Padding="12,4"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusLabel"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" x:Name="CoordLabel"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Name="PixelLabel"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="16,0" />
            <TextBlock Grid.Column="3" x:Name="ZoomLabel"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
