<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CanfarDesktop.Views.FitsViewer.FitsExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="Fits_ExportDialog"
    Title="Export figure"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1280</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1000" Height="600" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="264" />
        </Grid.ColumnDefinitions>

        <!-- A live preview of the plate, scaled down to fit. The saved figure is rendered separately at
             full size — scaling this one up would soften every glyph on it. -->
        <Border Grid.Column="0" CornerRadius="6" Padding="14"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Viewbox x:Name="PreviewBox" Stretch="Uniform" StretchDirection="DownOnly" />
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">

                <TextBlock x:Name="RegionSummary" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <StackPanel Spacing="2">
                    <TextBlock x:Uid="Fits_ExpThemeLabel" Text="Theme" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnStyleChanged">
                        <ComboBoxItem Content="Cockpit dark" />
                        <ComboBoxItem Content="Journal light" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock x:Uid="Fits_ExpFontLabel" Text="Font" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox x:Name="FontCombo" HorizontalAlignment="Stretch" SelectionChanged="OnStyleChanged">
                        <ComboBoxItem Content="Sans" />
                        <ComboBoxItem Content="Mono" />
                        <ComboBoxItem Content="Serif" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock x:Uid="Fits_ExpScaleLabel" Text="Scale" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox x:Name="ScaleCombo" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="1×" Tag="1" />
                        <ComboBoxItem Content="2×" Tag="2" />
                        <ComboBoxItem Content="4×" Tag="4" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="The marks and the text scale with the figure, so 4× is a bigger picture rather than the same one enlarged." />
                </StackPanel>

                <ToggleSwitch x:Name="AnnotateToggle" Header="Header and footer" IsOn="True" Toggled="OnStyleChanged" />
                <ToggleSwitch x:Name="MarksToggle" Header="Marks" IsOn="True" Toggled="OnStyleChanged" />
                <ToggleSwitch x:Name="TransparentToggle" Header="Transparent background" Toggled="OnStyleChanged" />

                <Button x:Name="SaveButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock x:Uid="Fits_ExpSaveText" Text="Save figure…" />
                    </StackPanel>
                </Button>

                <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
