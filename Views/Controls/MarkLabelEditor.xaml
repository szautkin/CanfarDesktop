<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CanfarDesktop.Views.Controls.MarkLabelEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left" VerticalAlignment="Top">

    <!--
        The little field you name a mark in.

        NOT a flyout. A flyout is its own surface: it dismisses itself the moment the pointer goes back
        to the image, it commits on close so Escape saves instead of cancelling, and it has nowhere to
        put a delete button. This is an ordinary control, so whoever opens it clips it to their own
        canvas and moves it as the mark moves.

        The host decides WHERE it goes, because only the host knows where the mark is on screen.
        Everything else — how it looks, what its buttons do, which keys it answers to — lives here, so
        the two viewers cannot drift into naming a mark differently.
    -->

    <Border CornerRadius="6" Padding="4" Background="#E0101622"
            BorderBrush="#50FFFFFF" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBox x:Name="Field" Width="180" MinHeight="28" AcceptsReturn="False"
                     x:Uid="Mark_LabelField" PlaceholderText="What is this?"
                     AutomationProperties.Name="Mark label" />

            <!-- Confirm sits LEFT of the bin: the safe action is the one a hand reaches first, and the
                 destructive one is not where a mis-click lands. -->
            <Button x:Name="DoneButton" Padding="8,4" Click="OnDone"
                    x:Uid="Mark_LabelDone" ToolTipService.ToolTip="Done"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Done">
                <FontIcon Glyph="&#xE8FB;" FontSize="12" />
            </Button>

            <Button x:Name="DeleteButton" Padding="8,4" Click="OnDelete"
                    x:Uid="Mark_LabelDelete" ToolTipService.ToolTip="Delete this mark"
                    AutomationProperties.Name="Delete this mark">
                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FFF4A0A0" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
