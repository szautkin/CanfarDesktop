<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CanfarDesktop.Views.Controls.CanfarImagesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CanfarDesktop.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74C;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Uid="Images_Header" Text="Canfar Images" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Images_SettingsBtn" Click="OnSettingsClick" Background="Transparent" BorderThickness="0" Padding="6,4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Image discovery settings (inspector image, registry credentials)"
                            AutomationProperties.Name="Image discovery settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <Button x:Uid="Images_FindByPackageBtn" Content="Find by package…" Click="OnFindByPackage"
                            ToolTipService.ToolTip="Search discovered images by installed package" />
                    <Button x:Uid="Images_FindInRegistryBtn" Content="Registry…" Click="OnFindInRegistry"
                            ToolTipService.ToolTip="Find an image the catalogue does not list" />
                </StackPanel>
            </Grid>

            <!-- Session type, then project: what kind of session, then whose images. The project row is
                 rebuilt from what the type leaves, so it only offers projects with something in them,
                 and hides itself when there is only one — a row with one choice is furniture. Each row
                 scrolls sideways: there are 21 projects, and a row as wide as all of them would set the
                 whole Portal's minimum width. Below them, how many of the images shown are inspected. -->
            <StackPanel Grid.Row="1" Spacing="4">
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <SelectorBar x:Name="TypeSelector" SelectionChanged="OnTypeChanged" />
                </ScrollViewer>
                <ScrollViewer x:Name="ProjectRow" Visibility="Collapsed"
                              HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <SelectorBar x:Name="ProjectFilter" x:Uid="Images_ProjectFilter" SelectionChanged="OnProjectChanged"
                                 AutomationProperties.Name="Filter images by project"
                                 ToolTipService.ToolTip="Filter by project" />
                </ScrollViewer>
                <TextBlock x:Name="DiscoveredText" Margin="4,2,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ListView Grid.Row="2" x:Name="ImageList" MaxHeight="320" SelectionMode="None"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CanfarImageRow">
                        <Grid ColumnSpacing="8" Padding="0,4" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontSize="16" VerticalAlignment="Center"
                                      Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                                      Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind MetaLine, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- One button, two jobs, and its label says which: an image nobody has
                                 probed needs probing, and a probed one has contents to show. Two
                                 buttons where only ever one applies is a row that asks to be read. -->
                            <Button Grid.Column="2" x:Name="RowAction" Content="{x:Bind ActionLabel, Mode=OneWay}"
                                    Click="OnInspectClick" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind ActionTooltip, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
