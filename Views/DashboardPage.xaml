<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CanfarDesktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CanfarDesktop.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- Three equal columns, the cards placed in them by PortalLayout: platform load, storage and batch
         jobs across the top, active sessions the full width, then CANFAR images beside recent launches —
         and one column below 1000 wide. The launch form is not a card: Launch session on Active sessions
         opens it in a dialog. -->
    <ScrollViewer x:Name="PortalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="OnPortalSizeChanged">
        <Grid x:Name="PortalGrid" Padding="24" RowSpacing="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PlatformLoadContainer" />
            <Border x:Name="StorageContainer" />
            <Border x:Name="BatchJobsContainer" />
            <Border x:Name="SessionListContainer" MinHeight="200" />
            <Border x:Name="CanfarImagesContainer" />
            <Border x:Name="RecentLaunchesContainer" />
        </Grid>
    </ScrollViewer>
</Page>
