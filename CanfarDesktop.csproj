<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CanfarDesktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Version>1.4.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CanfarDesktop.Tests\**" />
    <Content Remove="CanfarDesktop.Tests\**" />
    <None Remove="CanfarDesktop.Tests\**" />
    <!-- The MCP bridge is a separate exe project nested in this folder; keep it out of the app build. -->
    <Compile Remove="CanfarDesktop.McpBridge\**" />
    <Content Remove="CanfarDesktop.McpBridge\**" />
    <None Remove="CanfarDesktop.McpBridge\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verbinal branded logos (all scales auto-selected by Windows).
         CopyToOutputDirectory matters: without it these only enter the MSIX payload, and an
         unpackaged/loose-layout run has NO Assets folder — ms-appx image loads and
         AppWindow.SetIcon then fail silently (invisible icons). -->
    <Content Include="Assets\Square44x44Logo.scale-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square310x310Logo.scale-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SplashScreen.scale-*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The agent cues. The same bytes the Linux build plays, so the two apps sound alike. -->
    <Content Include="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.scale-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Verbinal.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Verbinal_icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Session type images -->
    <Content Include="Assets\session-notebook.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\session-desktop.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\session-carta.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\session-contributed.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\session-firefly.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    MCP bridge payload. Claude Desktop launches this exe directly, so every Store package must ship
    one: built from the source being packaged, for that package's own architecture.

    It used to be a manual release step — publish into a gitignored mcp-bridge\ folder, which the
    package included if it existed. Skipped, the package quietly shipped no bridge; left over, it
    shipped an old one; and with one folder for every architecture, whatever was published last went
    into all of them. The x86 packages of 1.3.2 and 1.3.3 both carried an x64 bridge, which cannot
    start on 32-bit Windows or on Windows 10 on ARM.

    Now every Release build publishes the bridge itself, for its own RuntimeIdentifier, into obj\,
    packs it at mcp-bridge\ (where McpBridgeLocator probes), and fails if it is not there.
    Self-contained single file: the machine needs no .NET of its own. Debug builds skip this — the
    locator finds the sibling project's build output instead.
  -->
  <Target Name="PublishMcpBridge" BeforeTargets="AssignTargetPaths"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <!-- Resolved here, not at evaluation: the SDK infers RuntimeIdentifier from Platform later. -->
      <McpBridgeRid>$(RuntimeIdentifier)</McpBridgeRid>
      <McpBridgeRid Condition="'$(McpBridgeRid)' == '' and '$(Platform)' == 'x86'">win-x86</McpBridgeRid>
      <McpBridgeRid Condition="'$(McpBridgeRid)' == '' and '$(Platform)' == 'ARM64'">win-arm64</McpBridgeRid>
      <McpBridgeRid Condition="'$(McpBridgeRid)' == ''">win-x64</McpBridgeRid>
      <McpBridgePlatform>x64</McpBridgePlatform>
      <McpBridgePlatform Condition="'$(McpBridgeRid)' == 'win-x86'">x86</McpBridgePlatform>
      <McpBridgePlatform Condition="'$(McpBridgeRid)' == 'win-arm64'">ARM64</McpBridgePlatform>
      <McpBridgeDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)mcp-bridge\$(McpBridgeRid)</McpBridgeDir>
      <McpBridgeProject>$(MSBuildProjectDirectory)\CanfarDesktop.McpBridge\CanfarDesktop.McpBridge.csproj</McpBridgeProject>
      <McpBridgeDotnet>$(DOTNET_HOST_PATH)</McpBridgeDotnet>
      <McpBridgeDotnet Condition="'$(McpBridgeDotnet)' == ''">dotnet</McpBridgeDotnet>
    </PropertyGroup>

    <!--
      A separate process, not the MSBuild task: the bridge is its own app with its own restore for this
      RuntimeIdentifier, and none of the properties of the build packaging it should reach it.
    -->
    <Exec Command="&quot;$(McpBridgeDotnet)&quot; publish &quot;$(McpBridgeProject)&quot; -c Release -r $(McpBridgeRid) -p:Platform=$(McpBridgePlatform) -p:SelfContained=true -p:PublishSingleFile=true -o &quot;$(McpBridgeDir)&quot; -nologo -v:q" />

    <Error Condition="!Exists('$(McpBridgeDir)\CanfarDesktop.McpBridge.exe')"
           Text="The MCP bridge was not published to $(McpBridgeDir). A package without it cannot connect an AI assistant." />

    <ItemGroup>
      <Content Include="$(McpBridgeDir)\CanfarDesktop.McpBridge.exe" Link="mcp-bridge\CanfarDesktop.McpBridge.exe"
               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Notebook\kernel_harness.py" />
    <EmbeddedResource Include="Resources\Workflows\*.workflow.md" />
    <EmbeddedResource Include="Resources\ImageDiscovery\probe.sh" />
    <EmbeddedResource Include="Resources\ImageDiscovery\inspector.sh" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 10.0.12, not earlier: it is the first to bring SQLitePCLRaw 2.1.12, and every 2.1.x before it
         bundles a SQLite older than 3.50.2 (CVE-2025-6965, GHSA-2m69-gcr7-jv3q, high). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="1.8.59" />
    <PackageReference Include="Vortice.Direct3D11" Version="1.8.59" />
    <PackageReference Include="Vortice.DXGI" Version="1.8.59" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>
</Project>